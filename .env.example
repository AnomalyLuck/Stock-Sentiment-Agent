# The application automatically reads .env in the current directory.
# Yahoo Finance requires no API key. OpenAI research still requires one.
OPENAI_API_KEY='your-openai-key'
OPENAI_MODEL=gpt-4.1
# Optional: research model (defaults to OPENAI_MODEL) and reviewer model (defaults to gpt-4.1-mini).
OPENAI_RESEARCH_MODEL=
OPENAI_VERIFY_MODEL=gpt-4.1-mini
STOCK_DIGEST_TIMEOUT=480
# Material profiles/verified evidence persist here; blank uses ~/.cache/stock-digest.
# Set to off to disable caching. Profiles expire after 7 days; verifications after 30 minutes.
STOCK_DIGEST_CACHE_DIR=
# Optional: enables SEC EDGAR filings (item codes, acceptance times). SEC requires contact details.
SEC_USER_AGENT=

# --- Social Sentiment tab (all optional) ---
# A missing key disables that source; StockTwits and Hacker News need no key.
# Keys stay on the local server and are never sent to the page.
# X posts via twitterapi.io: paid credits, $0.15 per 1,000 tweets returned, and every
# call bills. It is scraper-backed and not licensed by X.
X_API_PROVIDER=twitterapi
X_API_KEY=your-twitterapi-io-key
# Reddit comments via redditapis.com ($0.002 per read).
REDDIT_API_KEY=your-redditapis-com-token
# YouTube Data API v3 key (Google Cloud Console → enable "YouTube Data API v3" → API key).
YOUTUBE_API_KEY=your-youtube-api-key
# Company-alias lookup uses OPENAI_API_KEY above; model defaults to OPENAI_VERIFY_MODEL.
SOCIAL_ALIAS_MODEL=
# Tuning knobs (defaults shown; see stock_digest/social/config.py):
# X_MAX_PAGES=2  X_DAILY_TWEET_BUDGET=3000  X_PAGE_INTERVAL_S=0  X_MIN_FOLLOWERS=250  X_CACHE_TTL=900
# REDDIT_CACHE_TTL=900  REDDIT_MEGATHREAD_CACHE_TTL=300  REDDIT_MAX_SUBREDDITS_PER_QUERY=13
# REDDIT_MAX_COMMENT_TREES_PER_QUERY=16  REDDIT_DAILY_CALL_BUDGET=1000
# SEEKING_ALPHA_API_KEY=   # no provider supported yet
