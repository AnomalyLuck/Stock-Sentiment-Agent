# Portable public proxy configuration. See README.md: Running on a server.
# Set STOCK_DIGEST_DOMAINS using caddy.env.example and place stock-digest.users
# beside this file. Real login hashes stay outside version control.
# The app listens only on 127.0.0.1:8765; Caddy handles HTTPS and authentication.

{$STOCK_DIGEST_DOMAINS} {
	route {
		basic_auth {
			import stock-digest.users
		}

		# Paid API calls must originate in this site's browser UI.
		@external_api {
			path /api/*
			not header Sec-Fetch-Site same-origin
		}
		respond @external_api "Open the website and use its search form." 403

		# The UI auto-searches a ticker in the query string. Strip external page
		# queries before serving it. Use the raw query: parsed query matchers can
		# reject malformed unrelated parameters that the browser still accepts.
		@external_search_link {
			path / /index.html
			expression {http.request.uri.query} != ''
			not header Sec-Fetch-Site same-origin
		}
		redir @external_search_link / 303

		header X-Frame-Options DENY
		reverse_proxy 127.0.0.1:8765 {
			header_down +Content-Security-Policy "frame-ancestors 'none'"
			header_up -Authorization
			# Unknown Content-Length already makes Caddy flush progress immediately.
			# Avoid flush_interval -1: it prevents cancellation on client disconnect.
		}
	}
}
